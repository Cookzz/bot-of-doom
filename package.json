{
  "name": "bot-of-doom",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "build-windows": "bun build --compile --minify --target=bun-windows-x64 ./index.ts --outfile bodbot-windows-x64",
    "build-linux-arm": "bun build --compile --target=bun-linux-arm64 ./index.ts --outfile bodbot-linux-arm64",
    "build-linux": "bun build --compile --minify --target=bun-linux-x64 ./index.ts --outfile bodbot-linux-x64",
    "build-all": "bun build-windows && bun build-linux-arm && bun build-linux"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.4",
    "@seald-io/nedb": "^4.1.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "ky": "^1.14.3",
    "node-cron": "^4.2.1",
    "table": "^6.9.0"
  },
  "resolutions": {
    "undici": "^7.19.0"
  }
}
